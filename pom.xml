<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Extends spring-boot-starter-parent directly (not just importing its
        BOM below) so Spring Boot's plugin management applies too —
        specifically a JUnit-5-capable surefire version. Importing
        spring-boot-dependencies as a dependencyManagement BOM alone pins
        library versions but not plugin versions, which silently left tests
        unrun (surefire defaulted to an ancient pre-JUnit5 version — 2.12.4 —
        that found 0 tests without ever reporting an error).
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>io.vantage</groupId>
    <artifactId>vantage-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <!--
        Monorepo housing agent-core (shared library) and the two independent
        products that depend on it: log-analyzer-service and
        testcase-generator-service. Deliberately chose a monorepo (option 'a'
        from the architecture discussion) so agent-core changes stay in sync
        across both consumers without a separate publish/version-bump cycle
        while both products are still under active, roughly-parallel development.
        Revisit splitting agent-core into its own published artifact once
        release cadences diverge.
    -->

    <modules>
        <module>agent-core</module>
        <module>log-analyzer-service</module>
        <module>testcase-generator-service</module>
        <module>log-mcp-server</module>
        <module>code-mcp-server</module>
        <module>jira-rag-mcp-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.0</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
